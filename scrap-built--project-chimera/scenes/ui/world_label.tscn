[gd_scene load_steps=4 format=3 uid="uid://b2p0j8w2j8v"]

[sub_resource type="GDScript" id="GDScript_label"]
script/source = "extends Node2D

@export var text: String = \"LABEL\":
	set(value):
		text = value
		if is_inside_tree():
			$PanelContainer/MarginContainer/Label.text = value

@export var color: Color = Color(1, 0, 0):
	set(value):
		color = value
		if is_inside_tree():
			update_color()

func _ready():
	$PanelContainer/MarginContainer/Label.text = text
	update_color()
	
	# Animacja pływania góra-dół
	var tween = create_tween().set_loops()
	tween.tween_property($PanelContainer, \"position:y\", -3.0, 1.5).as_relative().set_trans(Tween.TRANS_SINE)
	tween.tween_property($PanelContainer, \"position:y\", 3.0, 1.5).as_relative().set_trans(Tween.TRANS_SINE)

func update_color():
	# Duplikujemy styl ramki, aby był unikalny dla tej instancji
	var style_box = $PanelContainer.get_theme_stylebox(\"panel\").duplicate()
	style_box.border_color = color
	$PanelContainer.add_theme_stylebox_override(\"panel\", style_box)
	
	# Duplikujemy LabelSettings, aby zmiana koloru tekstu nie wpływała na inne napisy
	if $PanelContainer/MarginContainer/Label.label_settings:
		$PanelContainer/MarginContainer/Label.label_settings = $PanelContainer/MarginContainer/Label.label_settings.duplicate()
		$PanelContainer/MarginContainer/Label.label_settings.font_color = color
"

